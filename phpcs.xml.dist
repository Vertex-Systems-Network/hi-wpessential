<?xml version="1.0"?>
<ruleset name="WPEssential">
	<description>WordPress Coding Standards for the WPEssential theme.</description>
	<file>.</file>
	<exclude-pattern>/tools/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>server/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="wpessential"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="wpessential"/><element value="WPESSENTIAL"/></property>
		</properties>
	</rule>
	<!-- Block patterns are template files: file comment + short PHP tags are expected. -->
	<rule ref="Squiz.Commenting.FileComment.Missing"><exclude-pattern>patterns/*</exclude-pattern></rule>
	<!-- core/ autoloads PSR-4 class files so it can be extracted into a plugin unchanged. -->
	<rule ref="WordPress.Files.FileName"><exclude-pattern>core/src/*</exclude-pattern></rule>
</ruleset>

msgstr "הפריסה, הכפתורים וסגנונות הטפסים של ה-Kit של Elementor הוגדרו."

#: core/src/Importer.php:1361
msgid "Everywhere"
msgstr "בכל מקום"

#: core/src/Importer.php:1369
msgid "Free shipping"
msgstr "משלוח חינם"

#. translators: %s: amount.
#: core/src/Importer.php:1377

#. Theme Name of the theme
#: style.css core/src/Admin.php:55 inc/patterns.php:14
msgid "WPEssential"
msgstr "WPEssential"

#. Theme URI of the theme
#. Author URI of the theme
#: style.css
msgid "https://wpessential.org/"
msgstr "https://wpessential.org/"

#. Description of the theme
#: style.css
msgid ""
"Lightweight multi-niche block theme, native for Gutenberg and Elementor. "
"One-click demos (free & pro) via the WPEssential Core plugin."
msgstr ""
"ערכת עיצוב בלוקים קלה ורב-תחומית, מותאמת באופן מובנה ל-Gutenberg ול-"
"Elementor. דמואים בלחיצה אחת (חינמיים ו-Pro) באמצעות התוסף WPEssential Core."

#. Author of the theme
#: style.css
msgid "WPEssential Team"
msgstr "צוות WPEssential"

#. translators: %s: error.

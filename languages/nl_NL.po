#: core/src/Importer.php:411
msgid ""
"Import finished with %d error. The site works; review the log for what was "
"skipped."
msgid_plural ""
"Import finished with %d errors. The site works; review the log for what was "
"skipped."
msgstr[0] ""
"Import voltooid met %d fout. De site werkt; bekijk het logboek voor wat is "
"overgeslagen."
msgstr[1] ""
"Import voltooid met %d fouten. De site werkt; bekijk het logboek voor wat is"
" overgeslagen."

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "Je site is klaar."


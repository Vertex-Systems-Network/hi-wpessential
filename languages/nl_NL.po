msgstr ""
"Je server heeft een aanpassing nodig voordat de import veilig kan worden "
"uitgevoerd."

#: core/src/Importer.php:602
msgid "Fix the items above (your host can help), then press Retry."
msgstr ""
"Los de bovenstaande punten op (je host kan helpen) en klik daarna op Opnieuw"
" proberen."

#. translators: %s: demo.
#: core/src/Importer.php:607
msgid ""
"%s was imported before. Its pages stay; the new import adds fresh copies."
msgstr ""
"%s is al eerder geïmporteerd. De pagina's blijven staan; de nieuwe import "
"voegt nieuwe kopieën toe."

#. translators: %s: demo.
#: core/src/Importer.php:607
msgid "Tick \"Remove previous demo\" next time for a clean site."
msgstr ""
"Vink de volgende keer \"Vorige demo verwijderen\" aan voor een schone site."

#: core/src/Importer.php:609
msgid "Server checks passed."
msgstr "Servercontroles geslaagd."

#. translators: %d: items.
#: core/src/Importer.php:621

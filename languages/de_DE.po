msgstr "Versand mit kostenloser Lieferung ab %s eingerichtet."

#. translators: %d: pages.
#: core/src/Importer.php:1412
msgid "Linked %d page to its new address."
msgid_plural "Linked %d pages to their new addresses."
msgstr[0] "%d Seite mit ihrer neuen Adresse verknüpft."
msgstr[1] "%d Seiten mit ihren neuen Adressen verknüpft."

#: core/src/Importer.php:1417
msgid "Permalinks and caches refreshed."
msgstr "Permalinks und Caches aktualisiert."

#: core/src/License.php:136
msgid ""
"That license key looks too short. Copy it again from your purchase email."
msgstr ""
"Dieser Lizenzschlüssel scheint zu kurz zu sein. Kopiere ihn erneut aus "
"deiner Kauf-E-Mail."

#: core/src/License.php:204
msgid ""
"This is a Pro item. Activate your license on the License tab to unlock it."
msgstr ""
"Dies ist ein Pro-Element. Aktiviere deine Lizenz im Tab „Lizenz“, um es "
"freizuschalten."

#: core/src/License/Adapter.php:84
msgid "The license server did not return a download link."
msgstr "Der Lizenzserver hat keinen Download-Link zurückgegeben."

#. translators: %s: error.
#: core/src/License/Adapter.php:107
msgid "The license server could not be reached: %s"
msgstr "Der Lizenzserver konnte nicht erreicht werden: %s"

#. translators: %d: HTTP status.
#: core/src/License/Adapter.php:113
msgid ""
"The license server answered with an unexpected response (HTTP %d). Try again"
" in a few minutes."
msgstr ""
"Der Lizenzserver hat mit einer unerwarteten Antwort reagiert (HTTP %d). "
"Versuche es in ein paar Minuten erneut."

#: core/src/License/Custom.php:42 core/src/License/Edd.php:31
#: core/src/License/Woo.php:58
msgid "This license key is not valid."
msgstr "Dieser Lizenzschlüssel ist ungültig."

#: core/src/License/Edd.php:27
msgid ""
"This license has expired. Renew it to keep receiving demos and updates."
msgstr ""
"Diese Lizenz ist abgelaufen. Verlängere sie, um weiterhin Demos und Updates "
"zu erhalten."

#: core/src/License/Edd.php:28
msgid "This license has been disabled."
msgstr "Diese Lizenz wurde deaktiviert."

#: core/src/License/Edd.php:29
msgid "This license has been revoked."
msgstr "Diese Lizenz wurde widerrufen."

#: core/src/License/Edd.php:30
msgid "This license key does not exist."
msgstr "Dieser Lizenzschlüssel existiert nicht."

#: core/src/License/Edd.php:32
msgid "This license is not active for this domain."
msgstr "Diese Lizenz ist für diese Domain nicht aktiv."

#: core/src/License/Edd.php:33
msgid "This key belongs to a different product."
msgstr "Dieser Schlüssel gehört zu einem anderen Produkt."

#: core/src/License/Edd.php:34
msgid ""
"This license has reached its activation limit. Deactivate it on another site"
" first."
msgstr ""
"Diese Lizenz hat ihr Aktivierungslimit erreicht. Deaktiviere sie zuerst auf "
"einer anderen Website."

#: core/src/License/Edd.php:130 core/src/License/Woo.php:118
msgid "The store did not return a download link for this license."
msgstr "Der Shop hat keinen Download-Link für diese Lizenz zurückgegeben."

#: core/src/Plugins.php:115
msgid "Your account is not allowed to install plugins."
msgstr "Dein Konto darf keine Plugins installieren."

#. translators: 1: plugin name, 2: error.
#: core/src/Plugins.php:130
msgid ""
"WordPress.org did not answer for %1$s (%2$s). Check the server can reach "
"wordpress.org, or install it manually."
msgstr ""
"WordPress.org hat für %1$s nicht geantwortet (%2$s). Überprüfe, ob der "
"Server wordpress.org erreichen kann, oder installiere es manuell."

#: core/src/Plugins.php:145
msgid "No download source is set for this plugin."
msgstr "Für dieses Plugin ist keine Download-Quelle festgelegt."

#: core/src/Plugins.php:158
msgid ""
"The plugin could not be installed. The server may lack write access to wp-"
"content/plugins."
msgstr ""
"Das Plugin konnte nicht installiert werden. Möglicherweise fehlen dem Server"
" Schreibrechte für wp-content/plugins."

#: core/src/Plugins.php:174
msgid "Plugin is not installed."
msgstr "Plugin ist nicht installiert."

#: core/src/Plugins.php:208
msgid "Your account is not allowed to delete plugins."
msgstr "Dein Konto darf keine Plugins löschen."

#: core/src/Rest.php:101
msgid "Demo not found."
msgstr "Demo nicht gefunden."

#: core/src/Rest.php:158
msgid "No imported demo was found."
msgstr "Es wurde keine importierte Demo gefunden."

#. translators: 1: demo, 2: count.
#: core/src/Rest.php:164
msgid "%1$s removed: %2$d items deleted and your previous settings restored."
msgstr ""
"%1$s entfernt: %2$d Elemente gelöscht und deine vorherigen Einstellungen "
"wiederhergestellt."

#: core/src/Rest.php:191
msgid "This plugin is not managed by WPEssential."
msgstr "Dieses Plugin wird nicht von WPEssential verwaltet."

#: core/src/Rest.php:323
msgid "Branding can be changed with a White Label plan."
msgstr "Das Branding kann mit einem White-Label-Tarif geändert werden."

#: core/src/Status.php:30
msgid "WordPress version"
msgstr "WordPress-Version"

#: core/src/Status.php:33
msgid "Update WordPress to 6.5 or newer."
msgstr "Aktualisiere WordPress auf Version 6.5 oder neuer."

#: core/src/Status.php:37
msgid "PHP version"
msgstr "PHP-Version"

#: core/src/Status.php:40
msgid ""
"PHP 8.1 or newer is faster and still supported. Ask your host to upgrade."
msgstr ""
"PHP 8.1 oder neuer ist schneller und wird weiterhin unterstützt. Bitte "
"deinen Hoster um ein Upgrade."

#: core/src/Status.php:44
msgid "Memory limit"
msgstr "Speicherlimit"

#: core/src/Status.php:45 core/src/Status.php:52
msgid "Unlimited"
msgstr "Unbegrenzt"

#: core/src/Status.php:47
msgid ""
"Set memory_limit to 256M in php.ini, or define WP_MEMORY_LIMIT in wp-"
"config.php."
msgstr ""
"Setze memory_limit in der php.ini auf 256M oder definiere WP_MEMORY_LIMIT in"
" der wp-config.php."

#: core/src/Status.php:51
msgid "Max execution time"
msgstr "Maximale Ausführungszeit"

#: core/src/Status.php:54
msgid "The importer works in short batches, so 30 seconds is enough."
msgstr ""
"Der Importer arbeitet in kleinen Schritten, daher reichen 30 Sekunden aus."

#: core/src/Status.php:58
msgid "Max upload size"
msgstr "Maximale Upload-Größe"

#: core/src/Status.php:61
msgid "Raise upload_max_filesize and post_max_size to at least 8M."
msgstr "Erhöhe upload_max_filesize und post_max_size auf mindestens 8M."

#: core/src/Status.php:65
msgid "Uploads folder"
msgstr "Upload-Ordner"


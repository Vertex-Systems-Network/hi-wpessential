msgstr "Layout, Buttons und Formularstile des Elementor-Kits festgelegt."

#: core/src/Importer.php:1361
msgid "Everywhere"
msgstr "Überall"

#: core/src/Importer.php:1369
msgid "Free shipping"
msgstr "Kostenloser Versand"

#. translators: %s: amount.
#: core/src/Importer.php:1377

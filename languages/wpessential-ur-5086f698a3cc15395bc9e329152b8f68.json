2\u0645\u062f \u0634\u0631\u0648\u0639 \u06a9\u0631\u06cc\u06ba"],"Preparing":["\u062a\u06cc\u0627\u0631\u06cc \u06c1\u0648 \u0631\u06c1\u06cc \u06c1\u06d2"],"Importing your demo\u2026":["\u0622\u067e \u06a9\u0627 \u0688\u06cc\u0645\u0648 \u062f\u0631\u0622\u0645\u062f \u06c1\u0648 \u0631\u06c1\u0627 \u06c1\u06d2\u2026"],"Keep this window open. It usually takes about a minute.":["\u06cc\u06c1 \u0648\u0646\u0688\u0648 \u06a9\u06be\u0644\u06cc \u0631\u06a9\u06be\u06cc\u06ba\u06d4 \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 \u0627\u0633 \u0645\u06cc\u06ba \u062a\u0642\u0631\u06cc\u0628\u0627\u064b \u0627\u06cc\u06a9 \u0645\u0646\u0679 \u0644\u06af\u062a\u0627 \u06c1\u06d2\u06d4"],"Cancel import":["\u062f\u0631\u0622\u0645\u062f \u0645\u0646\u0633\u0648\u062e \u06a9\u0631\u06cc\u06ba"],"Info":["\u0645\u0639\u0644\u0648\u0645\u0627\u062a"],"Success":["\u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc"],"Warnings":["\u0627\u0646\u062a\u0628\u0627\u06c1\u0627\u062a"],"Errors":["\u062e\u0631\u0627\u0628\u06cc\u0627\u06ba"],"Copy log":["\u0644\u0627\u06af \u06a9\u0627\u067e\u06cc \u06a9\u0631\u06cc\u06ba"],"Log copied":["\u0644\u0627\u06af \u06a9\u0627\u067e\u06cc \u06c1\u0648 \u06af\u06cc\u0627"],"Paste it into your support ticket.":["\u0627\u0633\u06d2 \u0627\u067e\u0646\u06d2 \u0633\u067e\u0648\u0631\u0679 \u0679\u06a9\u0679 \u0645\u06cc\u06ba \u067e\u06cc\u0633\u0679 \u06a9\u0631\u06cc\u06ba\u06d4"],"Stopped":["\u0631\u06a9 \u06af\u06cc\u0627"],"Step":["\u0645\u0631\u062d\u0644\u06c1"],"Complete":["\u0645\u06a9\u0645\u0644"],"%ss elapsed":["%ss \u06af\u0632\u0631 \u06af\u0626\u06d2"],"Resumed from the saved position.":["\u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u062f\u06c1 \u0645\u0642\u0627\u0645 \u0633\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u0631\u0648\u0639 \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4"],"Reload the page, then resume the import from the Demo Library.":["\u0635\u0641\u062d\u06c1 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba\u060c \u067e\u06be\u0631 \u0688\u06cc\u0645\u0648 \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc \u0633\u06d2 \u062f\u0631\u0622\u0645\u062f \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u0631\u0648\u0639 \u06a9\u0631\u06cc\u06ba\u06d4"],"Your progress is saved. Press Resume when the server is back.":["\u0622\u067e \u06a9\u06cc \u067e\u06cc\u0634 \u0631\u0641\u062a \u0645\u062d\u0641\u0648\u0638 \u06c1\u06d2\u06d4 \u0633\u0631\u0648\u0631 \u0648\u0627\u067e\u0633 \u0622\u0646\u06d2 \u067e\u0631 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u0631\u0648\u0639 \u06a9\u0631\u06cc\u06ba \u062f\u0628\u0627\u0626\u06cc\u06ba\u06d4"],"The server did not answer (%1$s). Retrying in %2$d seconds\u2026":["\u0633\u0631\u0648\u0631 \u0646\u06d2 \u062c\u0648\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u0627 (%1$s)\u06d4 %2$d \u0633\u06cc\u06a9\u0646\u0688 \u0645\u06cc\u06ba \u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u06cc \u062c\u0627 \u0631\u06c1\u06cc \u06c1\u06d2\u2026"],"The import stopped.":["\u062f\u0631\u0622\u0645\u062f \u0631\u06a9 \u06af\u0626\u06cc\u06d4"],"Import cancelled.":["\u062f\u0631\u0622\u0645\u062f \u0645\u0646\u0633\u0648\u062e \u06a9\u0631 \u062f\u06cc \u06af\u0626\u06cc\u06d4"],"Resume to finish it, or remove what was imported so far.":["\u0627\u0633\u06d2 \u0645\u06a9\u0645\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0634\u0631\u0648\u0639 \u06a9\u0631\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u0628 \u062a\u06a9 \u062f\u0631\u0622\u0645\u062f \u0634\u062f\u06c1 \u06c1\u0679\u0627 \u062f\u06cc\u06ba\u06d4"],"Import paused":["\u062f\u0631\u0622\u0645\u062f \u0645\u0648\u0642\u0648\u0641"],"The import needs your attention":["\u062f\u0631\u0622\u0645\u062f \u06a9\u0648 \u0622\u067e \u06a9\u06cc \u062a\u0648\u062c\u06c1 \u062f\u0631\u06a9\u0627\u0631 \u06c1\u06d2"],"Remove imported content":["\u062f\u0631\u0622\u0645\u062f \u0634\u062f\u06c1 \u0645\u0648\u0627\
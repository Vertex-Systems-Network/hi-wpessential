7\u0902\u0964"],"Your existing posts and pages are never changed. Imported items are tagged, so they can be removed in one click later.":["\u0906\u092a\u0915\u0940 \u092e\u094c\u091c\u0942\u0926\u093e \u092a\u094b\u0938\u094d\u091f \u0914\u0930 \u092a\u0947\u091c \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u0947 \u091c\u093e\u0924\u0947\u0964 \u0906\u092f\u093e\u0924 \u0915\u093f\u090f \u0917\u090f \u0906\u0907\u091f\u092e \u091f\u0948\u0917 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902, \u0924\u093e\u0915\u093f \u092c\u093e\u0926 \u092e\u0947\u0902 \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915 \u0915\u094d\u0932\u093f\u0915 \u092e\u0947\u0902 \u0939\u091f\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0964"],"Start import":["\u0906\u092f\u093e\u0924 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902"],"Preparing":["\u0924\u0948\u092f\u093e\u0930\u0940 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948"],"Importing your demo\u2026":["\u0906\u092a\u0915\u093e \u0921\u0947\u092e\u094b \u0906\u092f\u093e\u0924 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u2026"],"Keep this window open. It usually takes about a minute.":["\u092f\u0939 \u0935\u093f\u0902\u0921\u094b \u0916\u0941\u0932\u0940 \u0930\u0916\u0947\u0902\u0964 \u0907\u0938\u092e\u0947\u0902 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0932\u0917\u092d\u0917 \u090f\u0915 \u092e\u093f\u0928\u091f \u0932\u0917\u0924\u093e \u0939\u0948\u0964"],"Cancel import":["\u0906\u092f\u093e\u0924 \u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902"],"Info":["\u091c\u093e\u0928\u0915\u093e\u0930\u0940"],"Success":["\u0938\u092b\u0932"],"Warnings":["\u091a\u0947\u0924\u093e\u0935\u0928\u093f\u092f\u093e\u0901"],"Errors":["\u0924\u094d\u0930\u0941\u091f\u093f\u092f\u093e\u0901"],"Copy log":["\u0932\u0949\u0917 \u0915\u0949\u092a\u0940 \u0915\u0930\u0947\u0902"],"Log copied":["\u0932\u0949\u0917 \u0915\u0949\u092a\u0940 \u0939\u0941\u0906"],"Paste it into your support ticket.":["\u0907\u0938\u0947 \u0905\u092a\u0928\u0947 \u0938\u0939\u093e\u092f\u0924\u093e \u091f\u093f\u0915\u091f \u092e\u0947\u0902 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964"],"Stopped":["\u0930\u0941\u0915\u093e \u0939\u0941\u0906"],"Step":["\u091a\u0930\u0923"],"Complete":["\u092a\u0942\u0930\u094d\u0923"],"%ss elapsed":["%ss \u092c\u0940\u0924 \u0917\u090f"],"Resumed from the saved position.":["\u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0947 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"],"Reload the page, then resume the import from the Demo Library.":["\u092a\u0947\u091c \u0930\u0940\u0932\u094b\u0921 \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u0921\u0947\u092e\u094b \u0932\u093e\u0907\u092c\u094d\u0930\u0947\u0930\u0940 \u0938\u0947 \u0906\u092f\u093e\u0924 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"],"Your progress is saved. Press Resume when the server is back.":["\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0938\u0930\u094d\u0935\u0930 \u0935\u093e\u092a\u0938 \u0906\u0928\u0947 \u092a\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0926\u092c\u093e\u090f\u0901\u0964"],"The server did not answer (%1$s). Retrying in %2$d seconds\u2026":["\u0938\u0930\u094d\u0935\u0930 \u0928\u0947 \u0909\u0924\u094d\u0924\u0930 \u0928\u0939\u0940\u0902 \u0926\u093f\u092f\u093e (%1$s)\u0964 %2$d \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u2026"],"The import stopped.":["\u0906\u092f\u093e\u0924 \u0930\u0941\u0915 \u0917\u092f\u093e\u0964"],"Import cancelled.":["\u0906\u092f\u093e\u0924 \u0930\u0926\u094d\u0926 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"],"Resume to finish it, or remove what was imported so far.":["\u0907\u0938\u0947 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902, \u092f\u093e \u0905\u092c \u0924\u0915 \u0906\u092f\u093e\u0924 \u0915\u0940 \u0917\u0908 \u091a\u0940\u091c\u093c\u0947\u0902 \u0939\u091f\u093e\u090f\u0901\u0964"],"Import paused":["\u0906\u092f\u093e\u0924 \u0930\u094b\u0915\u093e \u0917\u092f\u093e"],"The import needs your attention":["\u0906\u092f\u093e\u0924 \u0915\u094b \u0906\u092a\u0915\u0947 \u0927\u094d\u092f\u093e\u0928 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u0948"],"Remove imported content":["\u0906\u092f\u093e\u0924 \u0915\u0940 \u0917\u0908 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0939\u091f\u093e\u090f\u0901"],"Resume":["\u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902"],"Back to options":["\u0935\u093f\u0915\u0932\u094d\u092a\u094b\u0902 \u092a\u0930 \u0935\u093e\u092a\u0938 \u091c\u093e\u090f\u0901"],"Everything was rolled back":["\u0938\u092c \u0915\u0941\u091b \u0935\u093e\u092a\u0938 \u0932\u0947 \u0932\u093f\u092f\u093e \u0917\u092f\u093e"],"Nothing to remove":["\u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0928\u0939\u0940\u0902"],"Rollback failed":["\u0930\u094b\u0932\u092c\u0948\u0915 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e"],"Resuming\u2026":["\u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u2026"],"Your progress is saved. Try again in a moment.":["\u0906\u092a\u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0925\u094b\u0921\u093c\u0940 \u0926\u0947\u0930 \u092e\u0947\u0902 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"],"Cancel the import? What was imported so far stays until you remove it
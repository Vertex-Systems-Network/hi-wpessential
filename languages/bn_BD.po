msgstr "%s ইতিমধ্যে সক্রিয়।"

#: core/src/Importer.php:708
msgid "file not found in the package"
msgstr "প্যাকেজে ফাইল পাওয়া যায়নি"

#. translators: 1: file, 2: error.
#: core/src/Importer.php:713
msgid "Image %1$s skipped (%2$s). Pages fall back to the theme copy."
msgstr "ছবি %1$s বাদ দেওয়া হয়েছে (%2$s)। পাতাগুলো থিমের কপি ব্যবহার করবে।"

#. translators: 1: file, 2: error.
#: core/src/Importer.php:727
msgid "Image %1$s skipped (%2$s)."
msgstr "ছবি %1$s বাদ দেওয়া হয়েছে (%2$s)।"

#. translators: 1: file, 2: error.
#: core/src/Importer.php:727
msgid "Check that the uploads folder is writable."
msgstr "আপলোড ফোল্ডারটি লেখার যোগ্য কিনা পরীক্ষা করুন।"

#. translators: %s: file.
#: core/src/Importer.php:735
msgid "Imported image %s."
msgstr "ছবি %s ইমপোর্ট করা হয়েছে।"

#. translators: 1: term, 2: taxonomy.
#. translators: 1: title, 2: post type.
#: core/src/Importer.php:750 core/src/Importer.php:796
msgid "Skipped \"%1$s\": %2$s is not available on this site."
msgstr "\"%1$s\" বাদ দেওয়া হয়েছে: এই সাইটে %2$s উপলব্ধ নয়।"

#. translators: %s: term.
#: core/src/Importer.php:757
msgid "Category \"%s\" already exists and was reused."
msgstr "বিভাগ \"%s\" আগে থেকেই আছে এবং পুনরায় ব্যবহার করা হয়েছে।"

#. translators: 1: term, 2: error.
#: core/src/Importer.php:769
msgid "Category \"%1$s\" was not created: %2$s"
msgstr "বিভাগ \"%1$s\" তৈরি হয়নি: %2$s"

#. translators: %s: term.
#: core/src/Importer.php:776
msgid "Created category \"%s\"."
msgstr "বিভাগ \"%s\" তৈরি করা হয়েছে।"

#. translators: 1: title, 2: error.
#: core/src/Importer.php:814

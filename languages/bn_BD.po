#: core/src/Admin.php:41 core/assets/admin.js:151 core/assets/admin.js:1363
msgid "System Status"
msgstr "সিস্টেম স্ট্যাটাস"

#: core/src/Admin.php:133
msgid ""
"The WPEssential dashboard needs JavaScript. Enable it in your browser to "
"import demos."
msgstr ""
"WPEssential ড্যাশবোর্ডের জন্য JavaScript প্রয়োজন। ডেমো ইমপোর্ট করতে আপনার "
"ব্রাউজারে এটি চালু করুন।"

#: core/src/Demos.php:49
msgid ""
"The online demo library could not be reached, so only the demos bundled with"
" the theme are listed. They import fully offline."
msgstr ""
"অনলাইন ডেমো লাইব্রেরিতে পৌঁছানো যায়নি, তাই শুধু থিমের সাথে থাকা ডেমোগুলো "
"দেখানো হচ্ছে। এগুলো সম্পূর্ণ অফলাইনে ইমপোর্ট হয়।"

#: core/src/Demos.php:180
msgid ""
"The bundled demo package is incomplete. Re-upload the theme and try again."
msgstr ""
"থিমের সাথে থাকা ডেমো প্যাকেজটি অসম্পূর্ণ। থিমটি আবার আপলোড করে পুনরায় "
"চেষ্টা করুন।"

#: core/src/Demos.php:190
msgid "This demo has no download address in the library."
msgstr "লাইব্রেরিতে এই ডেমোর কোনো ডাউনলোড ঠিকানা নেই।"

#. translators: %s: error message.
#: core/src/Demos.php:203
msgid "Downloading the demo package failed: %s"
msgstr "ডেমো প্যাকেজ ডাউনলোড ব্যর্থ হয়েছে: %s"

#: core/src/Demos.php:207
msgid "WordPress cannot write to the uploads folder. Check its permissions."
msgstr "WordPress আপলোড ফোল্ডারে লিখতে পারছে না। এর অনুমতিগুলো পরীক্ষা করুন।"

#: core/src/Demos.php:214
msgid "The downloaded package does not contain content.json."
msgstr "ডাউনলোড করা প্যাকেজে content.json নেই।"

#: core/src/Importer.php:47
msgid "Checking your server"
msgstr "আপনার সার্ভার পরীক্ষা করা হচ্ছে"

#: core/src/Importer.php:48
msgid "Removing the previous demo"
msgstr "আগের ডেমো সরানো হচ্ছে"

#: core/src/Importer.php:49
msgid "Preparing the demo package"
msgstr "ডেমো প্যাকেজ প্রস্তুত করা হচ্ছে"

#: core/src/Importer.php:50
msgid "Installing plugins"
msgstr "প্লাগইন ইনস্টল করা হচ্ছে"

#: core/src/Importer.php:51
msgid "Importing images"
msgstr "ছবি ইমপোর্ট করা হচ্ছে"

#: core/src/Importer.php:52
msgid "Creating categories"
msgstr "বিভাগ তৈরি করা হচ্ছে"

#: core/src/Importer.php:53
msgid "Building pages and posts"
msgstr "পাতা ও পোস্ট তৈরি করা হচ্ছে"

#: core/src/Importer.php:54
msgid "Adding products"
msgstr "পণ্য যোগ করা হচ্ছে"

#: core/src/Importer.php:55
msgid "Creating menus"
msgstr "মেনু তৈরি করা হচ্ছে"

#: core/src/Importer.php:56
msgid "Applying site settings"
msgstr "সাইট সেটিংস প্রয়োগ করা হচ্ছে"

#: core/src/Importer.php:57
msgid "Finishing touches"
msgstr "শেষ ছোঁয়া দেওয়া হচ্ছে"

#: core/src/Importer.php:90
msgid ""
"Another import is running in a different tab. Wait for it to finish, or wait"
" two minutes and try again."
msgstr ""
"অন্য একটি ট্যাবে আরেকটি ইমপোর্ট চলছে। সেটি শেষ হওয়া পর্যন্ত অপেক্ষা করুন, "
"অথবা দুই মিনিট পর আবার চেষ্টা করুন।"

#: core/src/Importer.php:94
msgid "This demo is no longer in the library. Refresh the page."
msgstr "এই ডেমোটি আর লাইব্রেরিতে নেই। পাতাটি রিফ্রেশ করুন।"

#: core/src/Importer.php:97
msgid "This demo is not available for the selected builder."
msgstr "এই ডেমোটি নির্বাচিত বিল্ডারের জন্য উপলব্ধ নয়।"

#: core/src/Importer.php:100
msgid ""
"This is a Pro demo. Activate your license on the License tab to import it."
msgstr ""
"এটি একটি Pro ডেমো। এটি ইমপোর্ট করতে লাইসেন্স ট্যাবে আপনার লাইসেন্স সক্রিয় "
"করুন।"

#. translators: 1: demo, 2: builder.
#: core/src/Importer.php:192
msgid "Starting import of %1$s for %2$s."
msgstr "%2$s-এর জন্য %1$s ইমপোর্ট শুরু হচ্ছে।"

#: core/src/Importer.php:207
msgid "There is no import to continue."
msgstr "চালিয়ে যাওয়ার মতো কোনো ইমপোর্ট নেই।"

#: core/src/Importer.php:225
msgid ""
"Import cancelled. Everything imported so far can be removed from the Demo "
"Library."
msgstr ""
"ইমপোর্ট বাতিল হয়েছে। এ পর্যন্ত ইমপোর্ট করা সবকিছু ডেমো লাইব্রেরি থেকে সরানো"
" যাবে।"

#: core/src/Importer.php:341
msgid "One item stopped the server twice and was skipped."
msgstr ""
"একটি আইটেম সার্ভারকে দুবার থামিয়ে দিয়েছে এবং সেটি বাদ দেওয়া হয়েছে।"

#: core/src/Importer.php:341
msgid ""
"Raise memory_limit / max_execution_time, then re-import to fill the gap."
msgstr ""
"memory_limit / max_execution_time বাড়ান, তারপর ঘাটতি পূরণ করতে আবার ইমপোর্ট"
" করুন।"

#. translators: %s: error.
#: core/src/Importer.php:358
msgid "Unexpected error: %s"
msgstr "অপ্রত্যাশিত ত্রুটি: %s"

#. translators: %d: errors.
#: core/src/Importer.php:411
msgid ""
"Import finished with %d error. The site works; review the log for what was "
"skipped."
msgid_plural ""
"Import finished with %d errors. The site works; review the log for what was "
"skipped."
msgstr[0] ""
"ইমপোর্ট %dটি ত্রুটিসহ শেষ হয়েছে। সাইটটি কাজ করছে; কী বাদ পড়েছে তা লগে "
"দেখুন।"
msgstr[1] ""
"ইমপোর্ট %dটি ত্রুটিসহ শেষ হয়েছে। সাইটটি কাজ করছে; কী বাদ পড়েছে তা লগে "
"দেখুন।"

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "আপনার সাইট প্রস্তুত।"

#: core/src/Importer.php:445
msgid "WooCommerce is not active, so the shop products were skipped."
msgstr "WooCommerce সক্রিয় নেই, তাই শপের পণ্যগুলো বাদ দেওয়া হয়েছে।"

#: core/src/Importer.php:608
msgid "Your server needs a change before the import can run safely."
msgstr "ইমপোর্ট নিরাপদে চালানোর আগে আপনার সার্ভারে একটি পরিবর্তন প্রয়োজন।"

#: core/src/Importer.php:608
msgid "Fix the items above (your host can help), then press Retry."
msgstr ""
"উপরের আইটেমগুলো ঠিক করুন (আপনার হোস্ট সাহায্য করতে পারে), তারপর আবার চেষ্টা "
"করুন চাপুন।"

#. translators: %s: demo.
#: core/src/Importer.php:613
msgid ""
"%s was imported before. Its pages stay; the new import adds fresh copies."
msgstr ""
"%s আগে ইমপোর্ট করা হয়েছিল। এর পাতাগুলো থাকবে; নতুন ইমপোর্ট নতুন কপি যোগ "
"করবে।"

#. translators: %s: demo.
#: core/src/Importer.php:613
msgid "Tick \"Remove previous demo\" next time for a clean site."
msgstr "পরিষ্কার সাইটের জন্য পরের বার \"আগের ডেমো সরান\"-এ টিক দিন।"

#: core/src/Importer.php:615
msgid "Server checks passed."
msgstr "সার্ভার পরীক্ষা সফল হয়েছে।"

#. translators: %d: items.
#: core/src/Importer.php:627
msgid "Removed %d items from the previous demo and restored its settings."
msgstr ""
"আগের ডেমো থেকে %dটি আইটেম সরানো হয়েছে এবং এর সেটিংস পুনরুদ্ধার করা হয়েছে।"

#: core/src/Importer.php:640
msgid "Upload a fresh copy of the theme, then press Resume."
msgstr "থিমের একটি নতুন কপি আপলোড করুন, তারপর আবার শুরু করুন চাপুন।"

#: core/src/Importer.php:640
msgid "Check your internet connection and press Resume."
msgstr "আপনার ইন্টারনেট সংযোগ পরীক্ষা করুন এবং আবার শুরু করুন চাপুন।"

#: core/src/Importer.php:646
msgid "The demo package could not be read (content.json is damaged)."
msgstr "ডেমো প্যাকেজটি পড়া যায়নি (content.json ক্ষতিগ্রস্ত)।"

#: core/src/Importer.php:646
msgid "Clear the cache on the System Status tab and retry."
msgstr "সিস্টেম স্ট্যাটাস ট্যাবে ক্যাশ পরিষ্কার করে আবার চেষ্টা করুন।"

#. translators: 1: pages, 2: images, 3: products.
#: core/src/Importer.php:650
msgid "Package ready: %1$d pages and posts, %2$d images, %3$d products."
msgstr "প্যাকেজ প্রস্তুত: %1$dটি পাতা ও পোস্ট, %2$dটি ছবি, %3$dটি পণ্য।"

#. translators: 1: plugin, 2: error.
#: core/src/Importer.php:668
msgid "%1$s could not be set up: %2$s"
msgstr "%1$s সেট আপ করা যায়নি: %2$s"

#. translators: 1: plugin, 2: error.
#: core/src/Importer.php:668
msgid ""
"Install it from Plugins → Add New, then use the Plugins tab here to activate"
" it."
msgstr ""
"প্লাগইন → নতুন যোগ করুন থেকে এটি ইনস্টল করুন, তারপর এটি সক্রিয় করতে এখানে "
"প্লাগইন ট্যাব ব্যবহার করুন।"

#. translators: %s: plugin.
#: core/src/Importer.php:673
msgid "%s installed and activated."
msgstr "%s ইনস্টল ও সক্রিয় করা হয়েছে।"

#. translators: %s: plugin.
#: core/src/Importer.php:675
msgid "%s activated."
msgstr "%s সক্রিয় করা হয়েছে।"

#. translators: %s: plugin.
#: core/src/Importer.php:677
msgid "%s deactivated because it conflicts with this demo."
msgstr "%s নিষ্ক্রিয় করা হয়েছে কারণ এটি এই ডেমোর সাথে সাংঘর্ষিক।"

#. translators: %s: plugin.
#: core/src/Importer.php:679

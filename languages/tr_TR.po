#: core/src/Admin.php:55
msgid "WPEssential"
msgstr "WPEssential"

#. Theme URI of the theme
#. Author URI of the theme
#: style.css
msgid "https://wpessential.org/"
msgstr "https://wpessential.org/"

#. Description of the theme
#: style.css
msgid ""
"Lightweight multi-niche block theme, native for Gutenberg and Elementor. "
"One-click demos (free & pro) via the WPEssential Core plugin."
msgstr ""
"Gutenberg ve Elementor için yerel olarak geliştirilmiş, hafif ve çok amaçlı "
"blok teması. WPEssential Core eklentisi ile tek tıkla demo kurulumu "
"(ücretsiz ve pro)."

#. Author of the theme
#: style.css
msgid "WPEssential Team"
msgstr "WPEssential Ekibi"


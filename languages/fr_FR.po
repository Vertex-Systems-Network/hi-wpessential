#: core/src/Importer.php:411
msgid ""
"Import finished with %d error. The site works; review the log for what was "
"skipped."
msgid_plural ""
"Import finished with %d errors. The site works; review the log for what was "
"skipped."
msgstr[0] ""
"Importation terminée avec %d erreur. Le site fonctionne ; consultez le "
"journal pour voir ce qui a été ignoré."
msgstr[1] ""
"Importation terminée avec %d erreurs. Le site fonctionne ; consultez le "
"journal pour voir ce qui a été ignoré."

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "Votre site est prêt."


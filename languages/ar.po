msgid ""
"Import finished with %d error. The site works; review the log for what was "
"skipped."
msgid_plural ""
"Import finished with %d errors. The site works; review the log for what was "
"skipped."
msgstr[0] ""
"انتهى الاستيراد دون أخطاء (%d). الموقع يعمل؛ راجع السجل لمعرفة ما تم تخطيه."
msgstr[1] ""
"انتهى الاستيراد مع خطأ واحد (%d). الموقع يعمل؛ راجع السجل لمعرفة ما تم "
"تخطيه."
msgstr[2] ""
"انتهى الاستيراد مع خطأين (%d). الموقع يعمل؛ راجع السجل لمعرفة ما تم تخطيه."
msgstr[3] ""
"انتهى الاستيراد مع %d أخطاء. الموقع يعمل؛ راجع السجل لمعرفة ما تم تخطيه."
msgstr[4] ""
"انتهى الاستيراد مع %d خطأً. الموقع يعمل؛ راجع السجل لمعرفة ما تم تخطيه."
msgstr[5] ""
"انتهى الاستيراد مع %d خطأ. الموقع يعمل؛ راجع السجل لمعرفة ما تم تخطيه."

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "موقعك جاهز."


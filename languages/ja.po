msgid ""
"This is a Pro demo. Activate your license on the License tab to import it."
msgstr "これは Pro デモです。インポートするには「ライセンス」タブでライセンスを有効化してください。"

#. translators: 1: demo, 2: builder.
#: core/src/Importer.php:192
msgid "Starting import of %1$s for %2$s."
msgstr "%2$s 用の %1$s のインポートを開始します。"


msgstr "予期しないエラー: %s"

#. translators: %d: errors.
#: core/src/Importer.php:411
msgid ""
"Import finished with %d error. The site works; review the log for what was "
"skipped."
msgid_plural ""
"Import finished with %d errors. The site works; review the log for what was "
"skipped."
msgstr[0] "インポートは %d 件のエラーで完了しました。サイトは動作します。スキップされた内容はログで確認してください。"

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "サイトの準備ができました。"

#: core/src/Importer.php:445

msgstr ""
"WordPress.org nie odpowiedział dla %1$s (%2$s). Sprawdź, czy serwer może "
"połączyć się z wordpress.org, lub zainstaluj ją ręcznie."

#: core/src/Plugins.php:145
msgid "No download source is set for this plugin."
msgstr "Dla tej wtyczki nie ustawiono źródła pobierania."

#: core/src/Plugins.php:158
msgid ""
"The plugin could not be installed. The server may lack write access to wp-"
"content/plugins."
msgstr ""
"Nie można zainstalować wtyczki. Serwer może nie mieć uprawnień zapisu do wp-"
"content/plugins."

#: core/src/Plugins.php:174
msgid "Plugin is not installed."
msgstr "Wtyczka nie jest zainstalowana."

#: core/src/Plugins.php:208

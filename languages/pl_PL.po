#: core/src/Importer.php:90
msgid ""
"Another import is running in a different tab. Wait for it to finish, or wait"
" two minutes and try again."
msgstr ""
"W innej karcie trwa już inny import. Poczekaj, aż się zakończy, lub odczekaj"
" dwie minuty i spróbuj ponownie."

#: core/src/Importer.php:94
msgid "This demo is no longer in the library. Refresh the page."
msgstr "Tego demo nie ma już w bibliotece. Odśwież stronę."

#: core/src/Importer.php:97
msgid "This demo is not available for the selected builder."
msgstr "To demo nie jest dostępne dla wybranego kreatora."

#: core/src/Importer.php:100
msgid ""
"This is a Pro demo. Activate your license on the License tab to import it."
msgstr ""
"To jest demo Pro. Aktywuj licencję w karcie Licencja, aby je zaimportować."

#. translators: 1: demo, 2: builder.
#: core/src/Importer.php:192
msgid "Starting import of %1$s for %2$s."
msgstr "Rozpoczynanie importu %1$s dla %2$s."

#: core/src/Importer.php:207
msgid "There is no import to continue."
msgstr "Brak importu do wznowienia."

#: core/src/Importer.php:225
msgid ""
"Import cancelled. Everything imported so far can be removed from the Demo "
"Library."
msgstr ""
"Import anulowano. Wszystko, co zostało dotąd zaimportowane, można usunąć z "
"Biblioteki demo."

#: core/src/Importer.php:341
msgid "One item stopped the server twice and was skipped."
msgstr "Jeden element dwukrotnie zatrzymał serwer i został pominięty."

#: core/src/Importer.php:341
msgid ""
"Raise memory_limit / max_execution_time, then re-import to fill the gap."
msgstr ""
"Zwiększ memory_limit / max_execution_time, a następnie zaimportuj ponownie, "
"aby uzupełnić brakujące elementy."

#. translators: %s: error.
#: core/src/Importer.php:358
msgid "Unexpected error: %s"
msgstr "Nieoczekiwany błąd: %s"

#. translators: %d: errors.
#: core/src/Importer.php:411
msgid ""
"Import finished with %d error. The site works; review the log for what was "
"skipped."
msgid_plural ""
"Import finished with %d errors. The site works; review the log for what was "
"skipped."
msgstr[0] ""
"Import zakończył się z %d błędem. Witryna działa; sprawdź dziennik, aby "
"zobaczyć, co zostało pominięte."
msgstr[1] ""
"Import zakończył się z %d błędami. Witryna działa; sprawdź dziennik, aby "
"zobaczyć, co zostało pominięte."
msgstr[2] ""
"Import zakończył się z %d błędami. Witryna działa; sprawdź dziennik, aby "
"zobaczyć, co zostało pominięte."

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "Twoja witryna jest gotowa."

#: core/src/Importer.php:445
msgid "WooCommerce is not active, so the shop products were skipped."
msgstr "WooCommerce nie jest aktywny, więc produkty sklepu zostały pominięte."

#: core/src/Importer.php:608
msgid "Your server needs a change before the import can run safely."
msgstr "Serwer wymaga zmiany, zanim import będzie mógł bezpiecznie przebiec."

#: core/src/Importer.php:608
msgid "Fix the items above (your host can help), then press Retry."
msgstr ""
"Popraw powyższe elementy (Twój dostawca hostingu może pomóc), a następnie "
"kliknij Ponów."

#. translators: %s: demo.
#: core/src/Importer.php:613
msgid ""
"%s was imported before. Its pages stay; the new import adds fresh copies."
msgstr ""
"%s było już wcześniej zaimportowane. Jego strony pozostaną; nowy import doda"
" świeże kopie."

#. translators: %s: demo.
#: core/src/Importer.php:613
msgid "Tick \"Remove previous demo\" next time for a clean site."
msgstr ""
"Następnym razem zaznacz „Usuń poprzednie demo”, aby uzyskać czystą witrynę."

#: core/src/Importer.php:615
msgid "Server checks passed."
msgstr "Sprawdzanie serwera zakończone pomyślnie."

#. translators: %d: items.
#: core/src/Importer.php:627
msgid "Removed %d items from the previous demo and restored its settings."
msgstr ""
"Usunięto %d elementów poprzedniego demo i przywrócono jego ustawienia."

#: core/src/Importer.php:640
msgid "Upload a fresh copy of the theme, then press Resume."
msgstr "Prześlij świeżą kopię motywu, a następnie kliknij Wznów."


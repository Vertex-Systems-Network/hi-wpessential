#: core/src/Admin.php:133
msgid "The WPEssential dashboard needs JavaScript. Enable it in your browser to import demos."
msgstr "WPEssential डैशबोर्ड को JavaScript की ज़रूरत है। डेमो आयात करने के लिए अपने ब्राउज़र में इसे सक्षम करें।"

#: core/src/Demos.php:49
msgid "The online demo library could not be reached, so only the demos bundled with the theme are listed. They import fully offline."
msgstr "ऑनलाइन डेमो लाइब्रेरी तक नहीं पहुँचा जा सका, इसलिए केवल थीम के साथ आए डेमो दिखाए गए हैं। ये पूरी तरह ऑफ़लाइन आयात होते हैं।"

#: core/src/Demos.php:173
msgid "The bundled demo package is incomplete. Re-upload the theme and try again."
msgstr "थीम के साथ आया डेमो पैकेज अधूरा है। थीम को फिर से अपलोड करें और दोबारा प्रयास करें।"

#: core/src/Demos.php:183
msgid "This demo has no download address in the library."
msgstr "लाइब्रेरी में इस डेमो का कोई डाउनलोड पता नहीं है।"

#. translators: %s: error message.
#: core/src/Demos.php:196
msgid "Downloading the demo package failed: %s"
msgstr "डेमो पैकेज डाउनलोड करना विफल रहा: %s"

#: core/src/Demos.php:200
msgid "WordPress cannot write to the uploads folder. Check its permissions."
msgstr "WordPress अपलोड फ़ोल्डर में लिख नहीं सकता। इसकी अनुमतियाँ जाँचें।"

#: core/src/Demos.php:207
msgid "The downloaded package does not contain content.json."
msgstr "डाउनलोड किए गए पैकेज में content.json नहीं है।"

#: core/src/Importer.php:47
msgid "Checking your server"
msgstr "आपके सर्वर की जाँच हो रही है"

#: core/src/Importer.php:48
msgid "Removing the previous demo"
msgstr "पिछला डेमो हटाया जा रहा है"

#: core/src/Importer.php:49
msgid "Preparing the demo package"
msgstr "डेमो पैकेज तैयार किया जा रहा है"

#: core/src/Importer.php:50
msgid "Installing plugins"
msgstr "प्लगइन्स इंस्टॉल हो रहे हैं"

#: core/src/Importer.php:51
msgid "Importing images"
msgstr "छवियाँ आयात हो रही हैं"

#: core/src/Importer.php:52
msgid "Creating categories"
msgstr "श्रेणियाँ बनाई जा रही हैं"

#: core/src/Importer.php:53
msgid "Building pages and posts"
msgstr "पेज और पोस्ट बनाए जा रहे हैं"

#: core/src/Importer.php:54
msgid "Adding products"
msgstr "उत्पाद जोड़े जा रहे हैं"

#: core/src/Importer.php:55
msgid "Creating menus"
msgstr "मेनू बनाए जा रहे हैं"

#: core/src/Importer.php:56
msgid "Applying site settings"
msgstr "साइट सेटिंग्स लागू की जा रही हैं"

#: core/src/Importer.php:57
msgid "Finishing touches"
msgstr "अंतिम रूप दिया जा रहा है"

#: core/src/Importer.php:90
msgid "Another import is running in a different tab. Wait for it to finish, or wait two minutes and try again."
msgstr "दूसरे टैब में एक और आयात चल रहा है। उसके पूरा होने की प्रतीक्षा करें, या दो मिनट रुककर फिर से प्रयास करें।"

#: core/src/Importer.php:94
msgid "This demo is no longer in the library. Refresh the page."
msgstr "यह डेमो अब लाइब्रेरी में नहीं है। पेज रीफ़्रेश करें।"

#: core/src/Importer.php:97
msgid "This demo is not available for the selected builder."
msgstr "यह डेमो चुने गए बिल्डर के लिए उपलब्ध नहीं है।"

#: core/src/Importer.php:100
msgid "This is a Pro demo. Activate your license on the License tab to import it."
msgstr "यह एक Pro डेमो है। इसे आयात करने के लिए लाइसेंस टैब पर अपना लाइसेंस सक्रिय करें।"

#. translators: 1: demo, 2: builder.
#: core/src/Importer.php:192
msgid "Starting import of %1$s for %2$s."
msgstr "%2$s के लिए %1$s का आयात शुरू हो रहा है।"

#: core/src/Importer.php:207
msgid "There is no import to continue."
msgstr "जारी रखने के लिए कोई आयात नहीं है।"

#: core/src/Importer.php:225
msgid "Import cancelled. Everything imported so far can be removed from the Demo Library."
msgstr "आयात रद्द किया गया। अब तक आयात की गई हर चीज़ को डेमो लाइब्रेरी से हटाया जा सकता है।"

#: core/src/Importer.php:341
msgid "One item stopped the server twice and was skipped."
msgstr "एक आइटम ने सर्वर को दो बार रोक दिया और उसे छोड़ दिया गया।"

#: core/src/Importer.php:341
msgid "Raise memory_limit / max_execution_time, then re-import to fill the gap."
msgstr "memory_limit / max_execution_time बढ़ाएँ, फिर कमी पूरी करने के लिए दोबारा आयात करें।"

#. translators: %s: error.
#: core/src/Importer.php:358
msgid "Unexpected error: %s"
msgstr "अप्रत्याशित त्रुटि: %s"

#. translators: %d: errors.
#: core/src/Importer.php:411
msgid "Import finished with %d error. The site works; review the log for what was skipped."
msgid_plural "Import finished with %d errors. The site works; review the log for what was skipped."
msgstr[0] "आयात %d त्रुटि के साथ पूरा हुआ। साइट काम कर रही है; जो छोड़ा गया उसके लिए लॉग देखें।"
msgstr[1] "आयात %d त्रुटियों के साथ पूरा हुआ। साइट काम कर रही है; जो छोड़ा गया उसके लिए लॉग देखें।"

#: core/src/Importer.php:413
msgid "Your site is ready."
msgstr "आपकी साइट तैयार है।"

#: core/src/Importer.php:445
msgid "WooCommerce is not active, so the shop products were skipped."
msgstr "WooCommerce सक्रिय नहीं है, इसलिए शॉप उत्पाद छोड़ दिए गए।"

#: core/src/Importer.php:602
msgid "Your server needs a change before the import can run safely."
msgstr "आयात सुरक्षित रूप से चलाने से पहले आपके सर्वर में बदलाव ज़रूरी है।"

#: core/src/Importer.php:602
msgid "Fix the items above (your host can help), then press Retry."
msgstr "ऊपर दिए गए आइटम ठीक करें (आपका होस्ट मदद कर सकता है), फिर पुनः प्रयास दबाएँ।"

#. translators: %s: demo.
#: core/src/Importer.php:607
msgid "%s was imported before. Its pages stay; the new import adds fresh copies."
msgstr "%s पहले आयात किया गया था। इसके पेज बने रहेंगे; नया आयात नई प्रतियाँ जोड़ेगा।"

#. translators: %s: demo.
#: core/src/Importer.php:607
msgid "Tick \"Remove previous demo\" next time for a clean site."
msgstr "साफ़ साइट के लिए अगली बार \"पिछला डेमो हटाएँ\" पर टिक करें।"

#: core/src/Importer.php:609
msgid "Server checks passed."
msgstr "सर्वर जाँच सफल रही।"

#. translators: %d: items.
#: core/src/Importer.php:621
msgid "Removed %d items from the previous demo and restored its settings."
msgstr "पिछले डेमो से %d आइटम हटाए गए और उसकी सेटिंग्स पुनर्स्थापित की गईं।"

#: core/src/Importer.php:634
msgid "Upload a fresh copy of the theme, then press Resume."
msgstr "थीम की नई प्रति अपलोड करें, फिर फिर से शुरू करें दबाएँ।"

#: core/src/Importer.php:634
msgid "Check your internet connection and press Resume."
msgstr "अपना इंटरनेट कनेक्शन जाँचें और फिर से शुरू करें दबाएँ।"

#: core/src/Importer.php:640
msgid "The demo package could not be read (content.json is damaged)."
msgstr "डेमो पैकेज पढ़ा नहीं जा सका (content.json क्षतिग्रस्त है)।"

#: core/src/Importer.php:640
msgid "Clear the cache on the System Status tab and retry."
msgstr "सिस्टम स्थिति टैब पर कैश साफ़ करें और पुनः प्रयास करें।"

#. translators: 1: pages, 2: images, 3: products.

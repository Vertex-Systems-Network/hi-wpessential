msgid "Import finished with %d error. The site works; review the log for what was skipped."
msgid_plural "Import finished with %d errors. The site works; review the log for what was skipped."
msgstr[0] "Импорт завершён с %d ошибкой. Сайт работает; посмотрите в журнале, что было пропущено."
msgstr[1] "Импорт завершён с %d ошибками. Сайт работает; посмотрите в журнале, что было пропущено."
msgstr[2] "Импорт завершён с %d ошибками. Сайт работает; посмотрите в журнале, что было пропущено."


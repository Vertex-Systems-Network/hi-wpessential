{
	"name": "heading",
	"title": "Heading (WPEssential)",
	"icon": "heading",
	"elementor_icon": "eicon-t-letter",
	"keywords": [
		"heading",
		"title",
		"eyebrow",
		"gradient"
	],
	"panels": {
		"content": "Content",
		"style": "Style",
		"motion": "Hover & motion"
	},
	"attributes": {
		"eyebrow": {
			"type": "text",
			"label": "Eyebrow (small text above)",
			"default": ""
		},
		"text": {
			"type": "textarea",
			"label": "Heading",
			"default": "Launch a WordPress site"
		},
		"accent": {
			"type": "textarea",
			"label": "Accent words (after the heading)",
			"default": ""
		},
		"tag": {
			"type": "select",
			"label": "HTML tag",
			"default": "h2",
			"options": {
				"h1": "H1",
				"h2": "H2",
				"h3": "H3",
				"h4": "H4",
				"h5": "H5",
				"h6": "H6",
				"p": "Paragraph",
				"div": "Div",
				"span": "Span"
			}
		},
		"link": {
			"type": "url",
			"label": "Link",
			"default": ""
		},
		"accentNewLine": {
			"type": "toggle",
			"label": "Accent on a new line",
			"default": false
		},
		"align": {
			"type": "select",
			"panel": "style",
			"label": "Alignment",
			"responsive": true,
			"css": "--wpek-align",
			"default": "",
			"options": {
				"": "Default",
				"left": "Left",
				"center": "Center",
				"right": "Right"
			},
			"map": {
				"left": "--wpek-align:left;--wpek-mx:0 auto 0 0",
				"center": "--wpek-align:center;--wpek-mx:0 auto",
				"right": "--wpek-align:right;--wpek-mx:0 0 0 auto"
			}
		},
		"size": {
			"type": "range",
			"panel": "style",
			"label": "Font size",
			"responsive": true,
			"css": "--wpek-size",
			"unit": "px",
			"min": 12,
			"max": 160,
			"default": ""
		},
		"weight": {
			"type": "select",
			"panel": "style",
			"label": "Weight",
			"css": "--wpek-weight",
			"default": "",
			"options": {
				"": "Default",
				"400": "Regular",
				"500": "Medium",
				"600": "Semi bold",
				"700": "Bold",
				"800": "Extra bold"
			}
		},
		"lineHeight": {
			"type": "range",
			"panel": "style",
			"label": "Line height",
			"responsive": true,
			"css": "--wpek-lh",
			"unit": "",
			"min": 0.8,
			"max": 2,
			"step": 0.05,
			"default": ""
		},
		"tracking": {
			"type": "range",
			"panel": "style",
			"label": "Letter spacing",
			"responsive": true,
			"css": "--wpek-ls",
			"unit": "em",
			"min": -0.1,
			"max": 0.3,
			"step": 0.005,
			"default": ""
		},
		"maxWidth": {
			"type": "range",
			"panel": "style",
			"label": "Max width (characters)",
			"responsive": true,
			"css": "--wpek-max",
			"unit": "ch",
			"min": 8,
			"max": 80,
			"default": ""
		},
		"color": {
			"type": "color",
			"panel": "style",
			"label": "Colour",
			"css": "--wpek-color",
			"default": ""
		},
		"accentStyle": {
			"type": "select",
			"panel": "style",
			"label": "Accent style",
			"default": "gradient",
			"options": {
				"gradient": "Brand gradient",
				"primary": "Primary colour",
				"outline": "Outline",
				"highlight": "Highlighter"
			}
		},
		"eyebrowColor": {
			"type": "color",
			"panel": "style",
			"label": "Eyebrow colour",
			"css": "--wpek-eyebrow",
			"default": ""
		},
		"spaceBelow": {
			"type": "range",
			"panel": "style",
			"label": "Space below",
			"responsive": true,
			"css": "--wpek-gap",
			"unit": "px",
			"min": 0,
			"max": 160,
			"default": ""
		},
		"hover": {
			"type": "select",
			"panel": "motion",
			"label": "Hover (links)",
			"default": "underline",
			"options": {
				"none": "None",
				"underline": "Drawn underline",
				"glow": "Glow"
			}
		},
		"motion": {
			"type": "select",
			"panel": "motion",
			"label": "Entrance",
			"default": "none",
			"options": {
				"none": "None",
				"fade-up": "Fade up",
				"reveal": "Reveal"
			}
		}
	}
}